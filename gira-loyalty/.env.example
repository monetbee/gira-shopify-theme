# PostgreSQL is the production source of truth. Never commit a populated .env file.
DATABASE_URL=postgres://gira_loyalty:change-me@127.0.0.1:5432/gira_loyalty
PORT=4100
LOG_LEVEL=info

# Server-only Shopify configuration. Verify this domain before any live check.
# App and store must belong to the same Shopify organization.
SHOPIFY_SHOP_DOMAIN=giragiraglasses.myshopify.com
SHOPIFY_API_VERSION=2026-07
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Independently verify the GIRA Shop GID before setting it; never auto-enroll an API response.
# Format: gid://shopify/Shop/<numeric-id>. Required for a live check, even on the primary domain.
SHOPIFY_EXPECTED_SHOP_ID=
# Legacy SHOPIFY_API_KEY / SHOPIFY_API_SECRET are rejected, not aliases.
# Access tokens are acquired at runtime; never put them in this file.
