<div id="GiraCartDrawer" class="gira-cart-drawer" data-gira-cart-drawer aria-hidden="true">
  <button class="gira-cart-drawer__overlay" type="button" aria-label="Close cart" data-gira-cart-close></button>
  <aside class="gira-cart-drawer__panel" role="dialog" aria-modal="true" aria-label="Cart">
    <header class="gira-cart-drawer__header"><div><p>YOUR BAG</p><h2>CART</h2></div><button class="gira-cart-close" type="button" aria-label="Close cart" data-gira-cart-close>×</button></header>
    <div class="gira-cart-drawer__content">{% if cart.item_count > 0 %}{% for item in cart.items %}<article class="gira-cart-line"><a class="gira-cart-line__image" href="{{ item.url }}">{% if item.image %}{{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', widths: '120, 180, 240', alt: item.image.alt | default: item.product.title }}{% endif %}</a><div class="gira-cart-line__body"><div class="gira-cart-line__top"><div><a href="{{ item.url }}">{{ item.product.title }}</a>{% unless item.variant.title == 'Default Title' %}<p>{{ item.variant.title }}</p>{% endunless %}</div><button class="gira-cart-remove" type="button" data-gira-cart-change data-line-key="{{ item.key }}" data-quantity="0">REMOVE</button></div><div class="gira-cart-line__bottom"><div class="gira-cart-quantity"><button type="button" aria-label="Decrease quantity" data-gira-cart-change data-line-key="{{ item.key }}" data-quantity="{{ item.quantity | minus: 1 }}">−</button><span>{{ item.quantity }}</span><button type="button" aria-label="Increase quantity" data-gira-cart-change data-line-key="{{ item.key }}" data-quantity="{{ item.quantity | plus: 1 }}">+</button></div><p>{{ item.final_price | money }}</p></div></div></article>{% endfor %}{% else %}<div class="gira-cart-empty"><p>YOUR BAG IS EMPTY</p><span>Add a pair of shades to keep the mood going.</span><a class="gira-cart-action" href="{{ routes.all_products_collection_url }}" data-gira-cart-close>CONTINUE SHOPPING</a></div>{% endif %}</div>
    {% if cart.item_count > 0 %}<footer class="gira-cart-drawer__footer"><div><span>SUBTOTAL</span><strong>{{ cart.items_subtotal_price | money }}</strong></div><a class="gira-cart-secondary-action" href="{{ routes.cart_url }}">VIEW CART</a><a class="gira-cart-action" href="/checkout">CHECKOUT</a></footer>{% endif %}
  </aside>
</div>
