<main class="gira-cart-page" data-gira-cart-page><div class="gira-container gira-cart-page__container"><h1>YOUR BAG.</h1>{% if cart.item_count > 0 %}<div class="gira-cart-page__grid"><div class="gira-cart-page__lines">{% for item in cart.items %}<article class="gira-cart-page-line"><a class="gira-cart-page-line__image" href="{{ item.url }}">{% if item.image %}{{ item.image | image_url: width: 320 | image_tag: loading: 'lazy', widths: '160, 240, 320', alt: item.image.alt | default: item.product.title }}{% endif %}</a><div class="gira-cart-page-line__body"><div><a href="{{ item.url }}">{{ item.product.title }}</a>{% unless item.variant.title == 'Default Title' %}<p>{{ item.variant.title }}</p>{% endunless %}<span>{{ item.final_price | money }}</span></div><button class="gira-cart-remove" type="button" data-gira-cart-change data-line-key="{{ item.key }}" data-quantity="0">REMOVE</button><div class="gira-cart-page-line__bottom"><div class="gira-cart-quantity"><button type="button" aria-label="Decrease quantity" data-gira-cart-change data-line-key="{{ item.key }}" data-quantity="{{ item.quantity | minus: 1 }}">−</button><span>{{ item.quantity }}</span><button type="button" aria-label="Increase quantity" data-gira-cart-change data-line-key="{{ item.key }}" data-quantity="{{ item.quantity | plus: 1 }}">+</button></div><strong>{{ item.final_line_price | money }}</strong></div></div></article>{% endfor %}</div><aside class="gira-cart-summary"><p>SUMMARY</p><div><span>SUBTOTAL</span><strong>{{ cart.items_subtotal_price | money }}</strong></div><div><span>SHIPPING</span><span>CALCULATED AT CHECKOUT</span></div><a class="gira-cart-action" href="/checkout">CHECKOUT</a><a class="gira-cart-continue" href="{{ routes.all_products_collection_url }}">← CONTINUE SHOPPING</a></aside></div>{% else %}<div class="gira-cart-empty gira-cart-page__empty"><p>YOUR BAG IS EMPTY</p><span>Add a pair of shades to complete the look.</span><a class="gira-cart-action" href="{{ routes.all_products_collection_url }}">CONTINUE SHOPPING</a></div>{% endif %}</div></main>
{% schema %}{"name":"GIRA main cart","settings":[],"disabled_on":{"groups":["header","footer"]}}{% endschema %}
