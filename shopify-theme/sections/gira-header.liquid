<header class="gira-header" data-gira-header>
  <div class="gira-container gira-header__inner">
    <div class="gira-header__brand-area">
      <button class="gira-menu-button" type="button" aria-expanded="false" aria-controls="gira-mobile-menu-{{ section.id }}" data-gira-menu-toggle>
        <span class="visually-hidden">Open navigation menu</span>
        <span class="gira-menu-icon" aria-hidden="true"></span>
      </button>
      <a class="gira-brand-lockup" href="{{ routes.root_url }}" aria-label="{{ shop.name }} home">
        <span class="gira-mark" aria-hidden="true"></span><span class="gira-brand-wordmark">{{ section.settings.logo_text | default: 'GIRA' }}</span>
      </a>
    </div>

    <nav class="gira-nav" aria-label="Main navigation">
      {% if section.settings.menu != blank %}
        {% for link in section.settings.menu.links %}<a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a>{% endfor %}
      {% else %}
        <a href="{{ routes.all_products_collection_url }}">SHOP</a><a href="{{ routes.all_products_collection_url }}">NEW DROP</a><a href="/pages/about">STORY</a><a href="/pages/faq">FAQ</a>
      {% endif %}
    </nav>

    <div class="gira-header__actions">
      {% if section.settings.show_shop_button %}<a class="gira-header-cta" href="{{ section.settings.shop_link | default: routes.all_products_collection_url }}">{{ section.settings.shop_label }}</a>{% endif %}
      {% if customer %}
        {% assign sparks_balance = customer.metafields.gira_loyalty.balance.value | default: 0 %}
        {% assign account_url_parts = routes.account_url | split: '?' %}
        {% assign account_url_base = account_url_parts | first %}
        {% assign account_url_query = account_url_parts | last %}
      <div class="gira-header-account-menu" data-gira-account-menu>
        <a class="gira-header-member" href="/pages/my-gira" aria-label="MY GIRA: {{ sparks_balance }} SPARKS" aria-expanded="false" aria-haspopup="menu" aria-controls="gira-account-menu-{{ section.id }}" data-gira-account-toggle><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3.5"/><path d="M4.5 20c.8-4 3.1-6 7.5-6s6.7 2 7.5 6"/></svg><span class="gira-header-member__divider" aria-hidden="true"></span><span class="gira-header-member__sparks"><span aria-hidden="true">⚡</span><strong>{{ sparks_balance }}</strong><span>SPARKS</span></span></a>
        <div id="gira-account-menu-{{ section.id }}" class="gira-header-account-popover" role="menu" hidden data-gira-account-popover><p>GIRA CLUB{% if customer.first_name != blank %} / {{ customer.first_name }}{% endif %}</p><a href="/pages/my-gira" role="menuitem">MY GIRA</a><a href="{{ account_url_base }}{% if account_url_parts.size > 1 %}/orders?{{ account_url_query }}{% else %}/orders{% endif %}" role="menuitem">ORDER HISTORY</a><a href="{{ routes.account_profile_url }}" role="menuitem">PROFILE</a><a href="/pages/gira-club" role="menuitem">CLUB BENEFITS</a><a href="{{ routes.account_logout_url }}" role="menuitem">SIGN OUT</a></div>
      </div>
      {% else %}
        <a class="gira-header-login" href="/customer_authentication/login?return_to=%2Fpages%2Fmy-gira">LOG IN / JOIN FREE</a>
      {% endif %}
      <button class="gira-icon-button gira-cart-button" type="button" aria-label="Open cart" aria-expanded="false" aria-controls="GiraCartDrawer" data-gira-cart-toggle><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 4h2l1.6 10.2a2 2 0 0 0 2 1.7h8.8a2 2 0 0 0 2-1.7L21 7H6"/><circle cx="9" cy="20" r="1"/><circle cx="18" cy="20" r="1"/></svg><span data-gira-cart-count{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span></button>
    </div>
  </div>

  <div id="gira-mobile-menu-{{ section.id }}" class="gira-mobile-menu" hidden data-gira-mobile-menu>
    <nav class="gira-container" aria-label="Mobile navigation">
      {% if section.settings.menu != blank %}
        {% for link in section.settings.menu.links %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}
      {% else %}
        <a href="{{ routes.all_products_collection_url }}">SHOP</a><a href="{{ routes.all_products_collection_url }}">NEW DROP</a><a href="/pages/about">STORY</a><a href="/pages/faq">FAQ</a>
      {% endif %}
    </nav>
  </div>
</header>

{% schema %}
{"name":"GIRA header","settings":[{"type":"text","id":"logo_text","label":"Logo text","default":"GIRA"},{"type":"link_list","id":"menu","label":"Navigation menu"},{"type":"checkbox","id":"show_shop_button","label":"Show shop button","default":true},{"type":"text","id":"shop_label","label":"Shop button label","default":"SHOP NOW"},{"type":"url","id":"shop_link","label":"Shop button link"}]}
{% endschema %}
