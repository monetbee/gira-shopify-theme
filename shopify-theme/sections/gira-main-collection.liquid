<section class="gira-collection gira-collection--desktop-{{ section.settings.desktop_columns }} gira-collection--mobile-{{ section.settings.mobile_columns }}">
  <header class="gira-collection__hero"><div class="gira-container gira-collection__heading"><div><p class="gira-collection__kicker">{{ section.settings.eyebrow }}</p><h1>{{ section.settings.fallback_title | default: collection.title }}</h1></div><p>{{ collection.description | strip_html | default: section.settings.intro }}</p></div></header>
  <div class="gira-container gira-collection__content">
    <div class="gira-collection__toolbar">
      {% if section.settings.show_tags %}<nav class="gira-collection__tags" aria-label="Filter products by tag"><a href="{{ collection.url }}"{% if current_tags == blank %} aria-current="page"{% endif %}>ALL</a>{% for tag in collection.all_tags %}{% assign tag_handle = tag | handle %}<a href="{{ collection.url }}/{{ tag_handle }}"{% if current_tags contains tag %} aria-current="page"{% endif %}>{{ tag }}</a>{% endfor %}</nav>{% endif %}
      {% if section.settings.show_sort %}<form class="gira-collection__sort" method="get"><label for="SortBy-{{ section.id }}">SORT BY</label><select id="SortBy-{{ section.id }}" name="sort_by" data-gira-sort>{% for option in collection.sort_options %}<option value="{{ option.value }}"{% if option.value == collection.sort_by %} selected="selected"{% endif %}>{{ option.name | upcase }}</option>{% endfor %}</select></form>{% endif %}
    </div>
    {% paginate collection.products by section.settings.products_per_page %}
      <p class="gira-collection__count" aria-live="polite">{{ collection.products_count }} {% if collection.products_count == 1 %}PRODUCT{% else %}PRODUCTS{% endif %}{% if current_tags != blank %} / {{ current_tags | join: ', ' | upcase }}{% endif %}{% if paginate.pages > 1 %} / PAGE {{ paginate.current_page }} OF {{ paginate.pages }}{% endif %}</p>
      {% if collection.products_count > 0 %}<div class="gira-collection__grid">{% for product in collection.products %}{% render 'gira-product-card', product: product %}{% endfor %}</div>{% else %}<p class="gira-collection__empty">NO PRODUCTS FOUND. CHOOSE ANOTHER SIGNAL.</p>{% endif %}
      {% if paginate.pages > 1 %}<nav class="gira-collection__pagination" aria-label="Product pages">{% if paginate.previous %}<a href="{{ paginate.previous.url }}" aria-label="Previous page">←</a>{% endif %}{% for part in paginate.parts %}{% if part.is_link %}<a href="{{ part.url }}" aria-label="Page {{ part.title }}">{{ part.title }}</a>{% else %}<span{% if part.title == paginate.current_page %} aria-current="page"{% endif %}>{{ part.title }}</span>{% endif %}{% endfor %}{% if paginate.next %}<a href="{{ paginate.next.url }}" aria-label="Next page">→</a>{% endif %}</nav>{% endif %}
    {% endpaginate %}
  </div>
</section>
{% schema %}
{"name":"GIRA main collection","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"ALL SHADES"},{"type":"text","id":"fallback_title","label":"Fallback title","default":"SHOP THE COLLECTION."},{"type":"textarea","id":"intro","label":"Fallback intro","default":"Explore the full GIRA collection."},{"type":"range","id":"products_per_page","min":4,"max":48,"step":4,"label":"Products per page","default":12},{"type":"select","id":"desktop_columns","label":"Desktop columns","options":[{"value":"2","label":"2"},{"value":"3","label":"3"},{"value":"4","label":"4"}],"default":"4"},{"type":"select","id":"mobile_columns","label":"Mobile columns","options":[{"value":"1","label":"1"},{"value":"2","label":"2"}],"default":"2"},{"type":"checkbox","id":"show_tags","label":"Show product tags","default":true},{"type":"checkbox","id":"show_sort","label":"Show sort","default":true}],"presets":[{"name":"GIRA main collection"}]}
{% endschema %}
