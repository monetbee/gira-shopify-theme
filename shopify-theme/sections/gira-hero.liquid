{%- liquid
  assign featured_collection = section.settings.collection
  if featured_collection == blank
    assign featured_collection = collections.all
  endif
  capture slide_manifest
    render 'gira-hero-slides'
  endcapture
  assign slide_manifest = slide_manifest | strip
  assign slide_files = blank
  if slide_manifest != blank
    assign slide_files = slide_manifest | split: '|'
  endif
  assign slide_count = slide_files.size
  assign has_slider = false
  if slide_count > 1
    assign has_slider = true
  endif
  assign fallback_image = 'https://cdn.shopify.com/s/files/1/0736/6803/4643/files/2AFD2E8F-6A6F-4CC4-9E79-927247A0CAC6.jpg'
-%}
{{ 'gira-hero-slider.css' | asset_url | stylesheet_tag }}
<section class="gira-editorial-shell" data-gira-hero data-autoplay="{{ section.settings.autoplay }}" data-interval="{{ section.settings.interval | times: 1000 }}" data-duration="{{ section.settings.transition_duration | times: 1000 }}"{% if has_slider %} role="region" aria-roledescription="carousel" aria-label="GIRA"{% endif %}>
  <div class="gira-hero-slides">
    {%- if slide_count == 0 -%}
      <div class="gira-hero-slide is-active" data-gira-hero-slide>
        <img class="gira-hero-slide__media" src="{{ fallback_image }}" width="1122" height="1402" alt="" loading="eager" fetchpriority="high" decoding="async">
      </div>
    {%- else -%}
      {%- for file in slide_files -%}
        <div class="gira-hero-slide{% if forloop.first %} is-active{% endif %}" data-gira-hero-slide{% unless forloop.first %} aria-hidden="true"{% endunless %}{% if has_slider %} role="group" aria-roledescription="slide" aria-label="{{ forloop.index }} / {{ slide_count }}"{% endif %}>
          <img class="gira-hero-slide__media" src="{{ file | strip | asset_url }}" alt="" decoding="async"{% if forloop.first %} loading="eager" fetchpriority="high"{% else %} loading="lazy"{% endif %}>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>
  <div class="gira-hero-overlay" aria-hidden="true"></div>
  <div class="gira-best-sellers gira-container">
    <div class="gira-storefront-brand">
      <h1 class="gira-brand-wordmark">{{ section.settings.title }}</h1>
      <p>{{ section.settings.subtitle | replace: 'GO INSANE. REJECT AVERAGE.', '自分らしさを、その一本に。' }}</p>
      {%- if has_slider -%}
        <div class="gira-hero-controls">
          <button class="gira-hero-arrow" type="button" data-gira-hero-previous aria-label="前のスライド"><span aria-hidden="true">&#8592;</span></button>
          <div class="gira-hero-indicators" role="group" aria-label="スライドを選択">
            {%- for file in slide_files -%}
              <button class="gira-hero-indicator{% if forloop.first %} is-active{% endif %}" type="button" data-gira-hero-indicator="{{ forloop.index0 }}" aria-label="スライド {{ forloop.index }}"{% if forloop.first %} aria-current="true"{% endif %}></button>
            {%- endfor -%}
          </div>
          <button class="gira-hero-arrow" type="button" data-gira-hero-next aria-label="次のスライド"><span aria-hidden="true">&#8594;</span></button>
        </div>
      {%- endif -%}
    </div>
    <h2>人気のアイテム</h2>
    {% if featured_collection.products_count > 0 %}<div class="gira-product-track gira-best-sellers-track">{% for product in featured_collection.products limit: section.settings.products_to_show %}{% render 'gira-product-card', product: product %}{% endfor %}</div>{% else %}<p class="gira-empty-state">商品を準備しています。</p>{% endif %}
    {% if section.settings.button_label != blank %}<p class="gira-section-action"><a class="gira-shop-all" href="{{ section.settings.button_link | default: featured_collection.url }}">{{ section.settings.button_label | replace: 'SHOP ALL', 'すべての商品を見る' }} <span>→</span></a></p>{% endif %}
  </div>
</section>
<style>
.gira-storefront-brand{min-height:60svh;display:flex!important;flex-direction:column;justify-content:center;align-items:center;text-align:center!important;margin:0 0 2rem!important;}
.gira-storefront-brand .gira-brand-wordmark{margin:0!important;font-size:clamp(3.25rem,10vw,7rem)!important;}
.gira-storefront-brand > p{font-size:.85rem;letter-spacing:.08em;}
</style>
{% if has_slider %}<script src="{{ 'gira-hero-slider.js' | asset_url }}" defer="defer"></script>{% endif %}
{% schema %}
{
  "name": "GIRA hero + best sellers",
  "settings": [
    { "type": "paragraph", "content": "Heroの画像は shopify-theme/hero-slideshow-images/ フォルダの画像が自動で反映されます（README.md参照）。" },
    { "type": "checkbox", "id": "autoplay", "label": "自動切り替え", "default": true },
    { "type": "range", "id": "interval", "min": 3, "max": 15, "step": 1, "unit": "s", "label": "切り替え秒数", "default": 5 },
    { "type": "range", "id": "transition_duration", "min": 0.3, "max": 2, "step": 0.1, "unit": "s", "label": "フェード時間", "default": 0.8 },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "GIRA" },
    { "type": "text", "id": "title", "label": "Title", "default": "GIRA" },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "GO INSANE. REJECT AVERAGE." },
    { "type": "collection", "id": "collection", "label": "Best sellers collection" },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 8, "step": 1, "label": "Products to show", "default": 4 },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "SHOP ALL" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [ { "name": "GIRA hero + best sellers" } ]
}
{% endschema %}
