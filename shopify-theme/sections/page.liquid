{% comment %}
  This section is used in the page template to render store pages like About us
  or Contact us.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/page
{% endcomment %}

{% case page.handle %}
  {% when 'about' %}
    {% render 'gira-story-content' %}
  {% when 'faq' %}
    {% render 'gira-faq-content' %}
  {% when 'gira-club' %}
    {% render 'gira-club-content' %}
  {% when 'my-gira' %}
    {% render 'gira-my-gira-content' %}
  {% else %}
    <h1>{{ page.title }}</h1>
    {{ page.content }}
{% endcase %}

{% schema %}
{
  "name": "t:general.page",
  "settings": []
}
{% endschema %}
