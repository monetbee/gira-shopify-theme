<footer class="gira-footer">
  <div class="gira-container gira-footer__grid">
    <div><a class="gira-footer__brand" href="{{ routes.root_url }}">{{ section.settings.logo_text }}</a><p>{{ section.settings.brand_copy }}</p></div>
    <div><p class="gira-footer__label">{{ section.settings.menu_heading }}</p><ul>{% if section.settings.menu != blank %}{% for link in section.settings.menu.links %}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{% endfor %}{% else %}<li><a href="{{ routes.all_products_collection_url }}">SHOP</a></li><li><a href="/pages/about">ABOUT</a></li><li><a href="/pages/faq">FAQ</a></li>{% endif %}</ul></div>
    <div><p class="gira-footer__label">{{ section.settings.support_heading }}</p><ul>{% if section.settings.support_menu != blank %}{% for link in section.settings.support_menu.links %}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{% endfor %}{% else %}<li><a href="/pages/shipping">SHIPPING</a></li><li><a href="/pages/contact">CONTACT</a></li><li><a href="/pages/faq">RETURNS</a></li>{% endif %}</ul></div>
    <div><p class="gira-footer__label">{{ section.settings.newsletter_heading }}</p><p>{{ section.settings.newsletter_copy }}</p>{% form 'customer', class: 'gira-newsletter' %}<input type="hidden" name="contact[tags]" value="newsletter"><label class="visually-hidden" for="Newsletter-{{ section.id }}">Email address</label><input id="Newsletter-{{ section.id }}" type="email" name="contact[email]" value="{{ form.email }}" placeholder="EMAIL ADDRESS" autocorrect="off" autocapitalize="off" required><button type="submit">{{ section.settings.newsletter_button }}</button>{% endform %}</div>
  </div>
  <div class="gira-footer__bottom"><div class="gira-container"><span>© {{ 'now' | date: '%Y' }} {{ shop.name }}</span><span>{{ section.settings.bottom_copy }}</span></div></div>
</footer>

{% schema %}
{"name":"GIRA footer","settings":[{"type":"text","id":"logo_text","label":"Logo text","default":"GIRA"},{"type":"textarea","id":"brand_copy","label":"Brand copy","default":"Sunglasses for your mood, your city, and your next statement."},{"type":"text","id":"menu_heading","label":"Menu heading","default":"NAVIGATE"},{"type":"link_list","id":"menu","label":"Navigation menu"},{"type":"text","id":"support_heading","label":"Support heading","default":"SUPPORT"},{"type":"link_list","id":"support_menu","label":"Support menu"},{"type":"text","id":"newsletter_heading","label":"Newsletter heading","default":"JOIN"},{"type":"textarea","id":"newsletter_copy","label":"Newsletter copy","default":"Early access + insider drops."},{"type":"text","id":"newsletter_button","label":"Newsletter button","default":"JOIN"},{"type":"text","id":"bottom_copy","label":"Bottom copy","default":"Made for your next moment."}]}
{% endschema %}
